; Engine configuration file.
; Duel Arena — Yu-Gi-Oh! Two-Deck Local Duel
; Godot 4.7.1.stable

config_version=5

[application]

config/name="Duel Arena"
config/description="Local two-player Yu-Gi-Oh! TCG duel with a deterministic, rules-enforced engine."
run/main_scene="res://Scenes/ui/Boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.035, 0.04, 0.06, 1)

[input_devices]

pointing/emulate_touch_from_mouse=false
